# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, or local Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/blushbite

# ── NextAuth v5 ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# App URL (update for production)
AUTH_URL=http://localhost:3000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Console: https://console.cloud.google.com
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── X / Twitter OAuth 2.0 ────────────────────────────────────────────────────
# Developer portal: https://developer.twitter.com
# Redirect URI: http://localhost:3000/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# ── Didit Identity Verification ──────────────────────────────────────────────
# Dashboard: https://business.didit.me
# API key from your Didit workspace settings
DIDIT_API_KEY=
# Workflow ID from your Didit verification workflow
DIDIT_WORKFLOW_ID=
# Webhook secret — set in Didit dashboard under webhook configuration
DIDIT_WEBHOOK_SECRET=
# Same as DIDIT_WORKFLOW_ID, exposed to the client if needed
NEXT_PUBLIC_DIDIT_WORKFLOW_ID=

# ── Dev test account — reset via POST /api/dev/reset-test-user ───────────────
# Only active in NODE_ENV !== 'production'. Override to use a different address.
DEV_TEST_EMAIL=test@blushbite.dev
